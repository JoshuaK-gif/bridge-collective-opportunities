{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/newsletter/status",
      "destination": "/api/newsletter?action=status"
    },
    {
      "source": "/api/newsletter/test",
      "destination": "/api/newsletter?action=test"
    },
    {
      "source": "/api/newsletter/send",
      "destination": "/api/newsletter?action=send"
    },
    {
      "source": "/api/sitemap.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/api/rss.xml",
      "destination": "/api/seo?type=rss"
    },
    {
      "source": "/((?!api/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
