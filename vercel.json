{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/sitemap.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/api/rss.xml",
      "destination": "/api/seo?type=rss"
    }
  ]
}
