# ─── Frontend (Vite — only VITE_* vars reach the browser bundle) ────────────────
# Nhost Auth base URL. Sign-in happens directly against Nhost from the browser.
# Optional: src/api/client.js already defaults to the production project.
VITE_NHOST_AUTH_URL=https://ybgaidcwksqeuojraxoe.auth.ap-southeast-1.nhost.run/v1

# ─── Vercel API (server-side only; set these on the Vercel project) ─────────────
# Postgres connection string. For Nhost this is
#   postgresql://postgres:<password>@<subdomain>.db.<region>.nhost.run:5432/postgres?sslmode=require
# Nhost only accepts these connections when Public Access is enabled under
# Project → Settings → Database in the Nhost dashboard — without it every query
# fails with "no authentication method is found" (a PgBouncer error).
DATABASE_URL=postgresql://postgres:PASSWORD@SUBDOMAIN.db.REGION.nhost.run:5432/postgres?sslmode=require

# Optional fallbacks that api/_db.js uses when DATABASE_URL is unset/malformed.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# Nhost project that serves the JWKS used to verify access tokens (api/_auth.js).
# Both default to the production project.
# NHOST_SUBDOMAIN=
# NHOST_REGION=

# Cloudinary credentials used to sign direct-to-Cloudinary image uploads
# (api/admin.js). Uploads stay broken until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
